# Скопируйте этот файл в .env и заполните. Файл .env никому не пересылайте.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID тех, кому можно пользоваться ботом, через запятую.
# Свой ID узнаете командой /id у самого бота.
# * — бот открыт для всех (тогда обязательно впишите свой ID в ADMIN_USERS).
ALLOWED_USERS=
# Администраторы: без лимита, команды /admin, /ban, /unban.
# Если пусто — администраторы те, чьи ID вписаны в ALLOWED_USERS.
ADMIN_USERS=
# Сколько фото в день бесплатно у одного человека (кроме администраторов). 0 — без лимита.
DAILY_LIMIT=3
# Пакеты фото за звёзды Telegram: «фото:звёзды» через запятую. 0 — покупка выключена.
PACKS=1:5,10:25,50:100
# Кто отвечает на /paysupport (вопросы по оплате), например @ваш_ник
SUPPORT=
# Канал, на который нужно подать заявку, чтобы пользоваться ботом: ID вида -1001234567890
# или @имя для публичного. Бот должен быть админом канала с правом «Пригласительные ссылки».
# Пусто — без подписки.
CHANNEL_ID=
# Своя ссылка-приглашение с заявками. Пусто — бот создаст её сам.
CHANNEL_LINK=
# Сколько фото может ждать в очереди; остальным бот предложит прийти позже.
QUEUE_LIMIT=20
# Файл со счётчиками и списком забаненных
USERS_FILE=geobot_users.json

# Ключ OCR.space для чтения текста на фото (бесплатно: https://ocr.space/ocrapi)
OCR_SPACE_KEY=
OCR_LANGUAGE=rus

# Необязательно: ключ Gemini API из https://aistudio.google.com — тогда бот
# будет анализировать само изображение. Без ключа модуль выключен.
GEMINI_API_KEY=
# Модели для итогового анализа по порядку: когда у первой кончается дневной лимит,
# берётся следующая (лимиты у каждой модели свои). Можно не заполнять.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview
# Лёгкие модели с большим лимитом: находят на фото детали для увеличения.
GEMINI_LITE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Поиск Google внутри Gemini. На бесплатном тарифе для моделей Gemini 3 он недоступен,
# поэтому по умолчанию выключен (0). Включайте (1) только при платном тарифе.
GEMINI_SEARCH=0

# Запасная модель: делает итоговый анализ, когда у Gemini кончился дневной лимит.
# По умолчанию — бесплатная Kimi через OpenRouter (ключ: openrouter.ai → Keys, карта не нужна).
# Подойдёт любой API в формате OpenAI с поддержкой картинок (DeepSeek, Grok и др.).
FALLBACK_KEY=
FALLBACK_MODEL=moonshotai/kimi-k2.6:free
FALLBACK_URL=https://openrouter.ai/api/v1/chat/completions

# DeepSeek — следующая запасная модель после FALLBACK (по порядку: Gemini → FALLBACK → DeepSeek).
# Ключ: platform.deepseek.com → API keys. Платный: сначала пополните баланс (несколько долларов хватит на тысячи фото).
DEEPSEEK_API_KEY=
# Модель DeepSeek с поддержкой картинок. Название у DeepSeek менялось (deepseek-flash, deepseek-v4-flash-vision-exp):
# если в консоли ошибка «модель не найдена — проверьте DEEPSEEK_MODEL», подставьте то, что указано в их документации.
DEEPSEEK_MODEL=deepseek-flash

# Файл, где бот хранит историю ответов для /stats
HISTORY_FILE=geobot_history.json
# Подсказывать Gemini, где обычно оказывались ваши фото (по ответам /ответ). 0 — выключить.
HISTORY_HINT=1

# Контакт для User-Agent (требование OpenStreetMap), например ваш e-mail или ник
CONTACT=geobot

# Напоминания владельцу (тем, кто в ADMIN_USERS) в Telegram:
# продлить бесплатный сервер — каждые RENEW_DAYS дня (0 — выключить); кнопка ведёт в PANEL_URL
RENEW_DAYS=3
PANEL_URL=https://bot-hosting.net/panel
# выложить видео в TikTok — каждый день в это время по Москве (пусто — выключить)
VIDEO_REMINDER=10:30
