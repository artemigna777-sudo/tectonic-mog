# Скопируйте этот файл в .env и заполните. Файл .env никому не пересылайте.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID тех, кому можно пользоваться ботом, через запятую.
# Свой ID узнаете командой /id у самого бота.
ALLOWED_USERS=

# Ключ OCR.space для чтения текста на фото (бесплатно: https://ocr.space/ocrapi)
OCR_SPACE_KEY=
OCR_LANGUAGE=rus

# Необязательно: ключ Gemini API из https://aistudio.google.com — тогда бот
# будет анализировать само изображение. Без ключа модуль выключен.
GEMINI_API_KEY=
# Модели для итогового анализа по порядку: когда у первой кончается дневной лимит,
# берётся следующая (лимиты у каждой модели свои). Можно не заполнять.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview
# Лёгкие модели с большим лимитом: находят на фото детали для увеличения.
GEMINI_LITE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Поиск Google внутри Gemini. На бесплатном тарифе для моделей Gemini 3 он недоступен,
# поэтому по умолчанию выключен (0). Включайте (1) только при платном тарифе.
GEMINI_SEARCH=0

# Файл, где бот хранит историю ответов для /stats
HISTORY_FILE=geobot_history.json
# Подсказывать Gemini, где обычно оказывались ваши фото (по ответам /ответ). 0 — выключить.
HISTORY_HINT=1

# Контакт для User-Agent (требование OpenStreetMap), например ваш e-mail или ник
CONTACT=geobot
